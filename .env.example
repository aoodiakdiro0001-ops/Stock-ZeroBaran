# ===================================================================
# Stock-ZeroBaran — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم بمفاتيحك المجانية
# ===================================================================

# --- Supabase (PostgreSQL مجاني) ---
# احصل عليها من: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# --- Google Gemini API (مجاني) ---
# احصل على المفتاح من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Groq API (بديل مجاني سريع) ---
# احصل على المفتاح من: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# --- اختيار محرك الذكاء الاصطناعي: gemini | groq ---
AI_ENGINE=gemini

# --- Telegram Bot ---
# 1) تحدّث إلى @BotFather في تليجرام
# 2) أنشئ بوتاً جديداً وانسخ التوكن
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# معرّف الدردشة الذي سيستقبل التنبيهات (احصل عليه من @userinfobot)
TELEGRAM_CHAT_ID=your-chat-id

# --- إعدادات عامة ---
# المنطقة الزمنية للجدولة والتقارير
TIMEZONE=Asia/Baghdad
# عدد أيام السجل التاريخي المستخدمة لحساب معدل الاستهلاك
CONSUMPTION_WINDOW_DAYS=30
# عدد أيام السجل المستخدمة في التنبؤ
FORECAST_HISTORY_DAYS=90
# عدد أيام التنبؤ المستقبلية
FORECAST_HORIZON_DAYS=14
# عتبة التنبيه الحرج (الأيام المتبقية حتى النفاد)
CRITICAL_STOCKOUT_DAYS=5
# تفعيل/تعطيل إرسال التنبيهات
ALERTS_ENABLED=true
# تفعيل/تعطيل لوحة التحكم
DASHBOARD_ENABLED=true

# --- إعدادات السجل ---
LOG_LEVEL=INFO
